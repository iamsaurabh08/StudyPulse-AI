# ===================================================================
# StudyPulse AI - Environment Configuration Template
# ===================================================================

# Port configuration (Provided automatically by cloud hosting platforms)
PORT=5000

# Host binding (0.0.0.0 binds to all network interfaces)
HOST=0.0.0.0

# Flask Debug Mode (Set to 0 in production; set to 1 for local development)
FLASK_DEBUG=0

# Public site URL (Used for AI provider request headers in production)
SITE_URL=https://studypulse-ai.app

# Optional persistent database path (e.g. for Render Disk or Docker volume)
# If left blank, defaults to backend/study_planner.db
DATABASE_PATH=

# OpenRouter AI API Key (Optional)
# If provided, the planner and assistant use OpenRouter generative AI models.
# If omitted or left empty, the application functions seamlessly in
# offline mode using the deterministic Rule-Based Heuristic Scheduling Engine.
OPENROUTER_API_KEY=

# OpenRouter AI Model (Default: deepseek/deepseek-r1:free)
OPENROUTER_MODEL=deepseek/deepseek-r1:free
